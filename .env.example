# --- Telegram ---
# Єдине, що обовязково. Токен береш у @BotFather.
TELEGRAM_BOT_TOKEN=123456:AAF...

# Далі не обовязково. Якщо лишити порожнім, бот сам запамятає перший чат,
# з якого йому напишуть /start, і надалі шле алерти туди.
# Заповнюй, тільки якщо хочеш два окремі канали.
TELEGRAM_CHAT_ID_TOP=
# Чат для решти знахідок. Порожньо = все йде в той самий чат, що й ТОП.
TELEGRAM_CHAT_ID_ALL=
# Якщо використовуєш один чат з топіками, вкажи id топіків
TELEGRAM_TOPIC_ID_TOP=
TELEGRAM_TOPIC_ID_ALL=

# --- База даних ---
# Порожньо = локальний SQLite у ./data/vintsniper.db
# Для Render безкоштовного постав сюди зовнішній Postgres (Neon), інакше історія
# цін буде стиратись при кожному редеплої.
DATABASE_URL=

# --- Робота ---
LOG_LEVEL=INFO
# Порт для health-ендпоінта. Render підставляє свій автоматично.
PORT=10000
# Сухий прогін: шукає і логує, але нічого не шле в Telegram
DRY_RUN=0

# --- Discord (не обов'язково, працює паралельно з Telegram) ---
# Ціновий роутинг налаштовується в config/config.yaml -> discord.price_tier_bounds.
# За замовчуванням bounds: [15, 45] -> три канали: 0-15, 15-45, 45+.
# Створи вебхук на кожен канал: Server Settings -> Integrations -> Webhooks
# -> New Webhook -> Copy Webhook URL. Порожній рядок просто вимикає канал.
DISCORD_WEBHOOK_0=
DISCORD_WEBHOOK_1=
DISCORD_WEBHOOK_2=
